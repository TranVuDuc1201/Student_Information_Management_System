<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIMS (Student Information Management System)</title>
    
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Modern & Glassmorphism Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SIMS.styles.css" asp-append-version="true" />
</head>
<body class="sims-body">
    @if ((bool?)ViewData["HideNav"] != true)
    {
        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg glass-nav border-bottom">
                <div class="container-fluid px-lg-4">
                    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-area="" asp-controller="Auth" asp-action="Login">
                        <div class="brand-icon">
                            <i class="bi bi-mortarboard-fill text-white"></i>
                        </div>
                        <span class="gradient-text fw-extrabold tracking-tight">SIMS</span>
                    </a>
                    
                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#simsNavbar" aria-controls="simsNavbar"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-2 text-primary"></i>
                    </button>
                    
                    <div class="collapse navbar-collapse" id="simsNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                            <!-- Demo navigation links removed -->
                        </ul>
                        
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-primary-gradient px-3 py-2 rounded-pill fw-semibold text-white d-flex align-items-center gap-2" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Sign In</span>
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="@((bool?)ViewData["FluidLayout"] == true ? "p-0" : "container-fluid px-lg-4 py-4")">
        @RenderBody()
    </main>

    @if ((bool?)ViewData["HideFooter"] != true)
    {
        <footer class="footer-modern py-3 mt-auto">
            <div class="container-fluid px-lg-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 text-muted small">
                <div>
                    &copy; 2026 <strong class="text-dark">SIMS</strong> &bull; Applied Programming & Design Principles
                </div>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-muted">Privacy Policy</a>
                    <span>&bull;</span>
                    <a href="#" class="text-decoration-none text-muted">Terms of Service</a>
                    <span>&bull;</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">.NET 10.0 LTS</span>
                </div>
            </div>
        </footer>
    }

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js for portals -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
