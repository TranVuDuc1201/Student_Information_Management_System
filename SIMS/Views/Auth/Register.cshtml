@model SIMS.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Student Registration - SIMS";
    ViewData["HideNav"] = true;
    ViewData["HideFooter"] = true;
    ViewData["FluidLayout"] = true;
}

<div class="container-fluid min-vh-100 p-0 d-flex flex-column flex-lg-row">
    <!-- Left Hero: Aesthetic 3D Vector & Brand Graphic Area (Synchronized with Login) -->
    <div class="col-12 col-lg-6 d-flex flex-column justify-content-between p-4 p-md-5 auth-hero-section position-relative overflow-hidden">
        <!-- Floating Glassmorphic Ambient Orbs -->
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>

        <!-- Top Brand Header -->
        <div class="d-flex align-items-center gap-3 z-1">
            <div class="brand-icon shadow-lg">
                <i class="bi bi-mortarboard-fill text-white fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bolder m-0 tracking-tight text-white">SIMS</h3>
                <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 rounded-pill px-3 py-1 small">
                    v2.5 Next-Gen Portal
                </span>
            </div>
        </div>

        <!-- Center 3D Isometric Showcase (Student Benefits) -->
        <div class="my-auto py-5 text-center position-relative z-1">
            <div class="isometric-illustration-container mx-auto position-relative">
                <!-- Center Isometric Mock Visual -->
                <div class="glass-card p-4 mx-auto illustration-card">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                        <div class="d-flex gap-2">
                            <span class="rounded-circle bg-danger" style="width: 10px; height: 10px;"></span>
                            <span class="rounded-circle bg-warning" style="width: 10px; height: 10px;"></span>
                            <span class="rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
                        </div>
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1 text-xs">Student Intake</span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 rounded-3 bg-light text-start">
                                <span class="text-muted d-block" style="font-size: 0.7rem;">Program Track</span>
                                <span class="fw-bold fs-6 text-primary">B.Sc Honors</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded-3 bg-light text-start">
                                <span class="text-muted d-block" style="font-size: 0.7rem;">Degree Credits</span>
                                <span class="fw-bold fs-6 text-success">135 Units</span>
                            </div>
                        </div>
                    </div>

                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar bg-gradient-primary" role="progressbar" style="width: 100%;"></div>
                    </div>
                    <small class="text-muted text-start d-block" style="font-size: 0.75rem;">Verified Digital Identity & Academic Record</small>
                </div>

                <!-- Floating 3D Badges -->
                <div class="floating-badge badge-top-left glass-card p-3 shadow-lg">
                    <i class="bi bi-mortarboard-fill text-primary fs-3"></i>
                    <div class="text-start">
                        <div class="fw-bold small">Direct Matriculation</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Instant Portal Access</div>
                    </div>
                </div>

                <div class="floating-badge badge-bottom-right glass-card p-3 shadow-lg">
                    <i class="bi bi-patch-check-fill text-success fs-3"></i>
                    <div class="text-start">
                        <div class="fw-bold small">Encrypted Security</div>
                        <div class="text-muted" style="font-size: 0.7rem;">BCrypt Protected</div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-white">
                <h2 class="fw-extrabold text-white">Empowering Academic Excellence</h2>
                <p class="text-white text-opacity-80 mx-auto" style="max-width: 440px;">
                    Join your university academic community to access personalized course schedules, live grade tracking, and institutional resources.
                </p>
            </div>
        </div>

        <!-- Footer Note in Left Column -->
        <div class="z-1 text-white text-opacity-70 small">
            <span>&copy; 2026 Student Information Management System. Built with .NET 10.0</span>
        </div>
    </div>

    <!-- Right Column: Registration Card -->
    <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center p-4 p-md-5 bg-surface">
        <div class="w-100" style="max-width: 520px;">
            <div class="text-start mb-4">
                <a asp-controller="Auth" asp-action="Login" class="btn btn-sm btn-light rounded-pill mb-3 text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
                <h2 class="fw-bold font-heading mb-1">Create Student Account</h2>
                <p class="text-muted">Fill in your institutional credentials to enroll in SIMS.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 mb-4 p-3 shadow-sm" role="alert"></div>

            <form asp-controller="Auth" asp-action="Register" method="post" class="needs-validation">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <!-- Student Code -->
                    <div class="col-12 col-sm-6">
                        <label asp-for="StudentCode" class="form-label small fw-semibold text-secondary">Student ID / Code</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                                <i class="bi bi-card-text"></i>
                            </span>
                            <input asp-for="StudentCode" class="form-control form-control-modern border-start-0 ps-2" placeholder="e.g. STU1001" required />
                        </div>
                        <span asp-validation-for="StudentCode" class="text-danger small"></span>
                    </div>

                    <!-- Full Name -->
                    <div class="col-12 col-sm-6">
                        <label asp-for="FullName" class="form-label small fw-semibold text-secondary">Full Legal Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="FullName" class="form-control form-control-modern border-start-0 ps-2" placeholder="e.g. John Doe" required />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Email Address -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary">Institutional Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control form-control-modern border-start-0 ps-2" placeholder="e.g. john.doe@university.edu" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Degree Program Selection -->
                <div class="mb-3">
                    <label asp-for="Program" class="form-label small fw-semibold text-secondary">Degree Program</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                            <i class="bi bi-book"></i>
                        </span>
                        <select asp-for="Program" class="form-select form-control-modern border-start-0 ps-2">
                            <option value="Software Engineering">Software Engineering</option>
                            <option value="Artificial Intelligence">Artificial Intelligence</option>
                            <option value="Cybersecurity">Cybersecurity</option>
                            <option value="Information Systems">Information Systems</option>
                            <option value="Data Science">Data Science</option>
                        </select>
                    </div>
                    <span asp-validation-for="Program" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Password -->
                    <div class="col-12 col-sm-6">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control form-control-modern border-start-0 ps-2" placeholder="Min. 6 chars" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-12 col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-modern border-start-0 ps-2" placeholder="Repeat password" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-4 fw-bold fs-6 d-flex align-items-center justify-content-center gap-2">
                    <span>Complete Student Registration</span>
                    <i class="bi bi-check2-circle fs-5"></i>
                </button>
            </form>

            <div class="mt-4 text-center">
                <p class="text-muted small mb-0">
                    Already registered? 
                    <a asp-controller="Auth" asp-action="Login" class="text-primary fw-semibold text-decoration-none">
                        Sign in to your account
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-hero-section {
        background: linear-gradient(145deg, #312e81 0%, #4338ca 45%, #6366f1 100%);
        min-height: 400px;
    }

    .hero-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.45;
        pointer-events: none;
    }

    .hero-orb-1 {
        width: 380px;
        height: 380px;
        background: #ec4899;
        top: -60px;
        left: -60px;
    }

    .hero-orb-2 {
        width: 320px;
        height: 320px;
        background: #06b6d4;
        bottom: -40px;
        right: -40px;
    }

    .illustration-card {
        max-width: 360px;
        transform: perspective(1000px) rotateX(4deg) rotateY(-6deg);
        background: rgba(255, 255, 255, 0.92) !important;
        border-radius: 20px;
    }

    .floating-badge {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 16px;
        z-index: 2;
        animation: floatAnimation 4s ease-in-out infinite alternate;
    }

    .badge-top-left {
        top: -15px;
        left: 20px;
    }

    .badge-bottom-right {
        bottom: -20px;
        right: 25px;
        animation-delay: 2s;
    }

    @@keyframes floatAnimation {
        0% { transform: translateY(0px); }
        100% { transform: translateY(-10px); }
    }
</style>
