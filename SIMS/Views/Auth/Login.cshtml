@model SIMS.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In - SIMS";
    ViewData["HideNav"] = true;
    ViewData["HideFooter"] = true;
    ViewData["FluidLayout"] = true;
}

<div class="container-fluid min-vh-100 p-0 d-flex flex-column flex-lg-row">
    <!-- Left Hero: Aesthetic 3D Vector & Brand Graphic Area -->
    <div class="col-12 col-lg-6 d-flex flex-column justify-content-between p-4 p-md-5 auth-hero-section position-relative overflow-hidden">
        <!-- Floating Glassmorphic Ambient Orbs -->
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>

        <!-- Top Brand Header -->
        <div class="d-flex align-items-center gap-3 z-1">
            <div class="brand-icon shadow-lg">
                <i class="bi bi-mortarboard-fill text-white fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bolder m-0 tracking-tight text-white">SIMS</h3>
                <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 rounded-pill px-3 py-1 small">
                    v2.5 Next-Gen Portal
                </span>
            </div>
        </div>

        <!-- Center 3D Isometric Showcase -->
        <div class="my-auto py-5 text-center position-relative z-1">
            <div class="isometric-illustration-container mx-auto position-relative">
                <!-- Center Isometric Mock Visual (Pure CSS & SVG Vector) -->
                <div class="glass-card p-4 mx-auto illustration-card">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                        <div class="d-flex gap-2">
                            <span class="rounded-circle bg-danger" style="width: 10px; height: 10px;"></span>
                            <span class="rounded-circle bg-warning" style="width: 10px; height: 10px;"></span>
                            <span class="rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
                        </div>
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1 text-xs">Live Analytics</span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-2 rounded-3 bg-light text-start">
                                <span class="text-muted d-block" style="font-size: 0.7rem;">Average GPA</span>
                                <span class="fw-bold fs-5 text-primary">3.82</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded-3 bg-light text-start">
                                <span class="text-muted d-block" style="font-size: 0.7rem;">Completed</span>
                                <span class="fw-bold fs-5 text-success">85%</span>
                            </div>
                        </div>
                    </div>

                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar bg-gradient-primary" role="progressbar" style="width: 85%;"></div>
                    </div>
                    <small class="text-muted text-start d-block" style="font-size: 0.75rem;">Continuous Academic Performance Tracking</small>
                </div>

                <!-- Floating 3D Badges -->
                <div class="floating-badge badge-top-left glass-card p-3 shadow-lg">
                    <i class="bi bi-shield-check text-success fs-3"></i>
                    <div class="text-start">
                        <div class="fw-bold small">Enterprise Security</div>
                        <div class="text-muted" style="font-size: 0.7rem;">RBAC Protected</div>
                    </div>
                </div>

                <div class="floating-badge badge-bottom-right glass-card p-3 shadow-lg">
                    <i class="bi bi-lightning-charge-fill text-warning fs-3"></i>
                    <div class="text-start">
                        <div class="fw-bold small">Real-time GPA</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Instant Sync</div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-white">
                <h2 class="fw-extrabold text-white">Empowering Academic Excellence</h2>
                <p class="text-white text-opacity-80 mx-auto" style="max-width: 440px;">
                    Experience seamless student record management, intelligent grade reporting, and transparent university operations.
                </p>
            </div>
        </div>

        <!-- Footer Note in Left Column -->
        <div class="z-1 text-white text-opacity-70 small">
            <span>&copy; 2026 Student Information Management System. Built with .NET 10.0</span>
        </div>
    </div>

    <!-- Right Column: Login Card & Domain Switcher -->
    <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center p-4 p-md-5 bg-surface">
        <div class="w-100" style="max-width: 480px;">
            <div class="text-start mb-4">
                <h2 class="fw-bold font-heading mb-1">Welcome back</h2>
                <p class="text-muted">Select your portal domain and sign in to continue.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-4 d-flex align-items-center gap-2 mb-4 p-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger border-0 rounded-4 d-flex align-items-center gap-2 mb-4 p-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@Model.ErrorMessage</div>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" class="needs-validation">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Segmented Control for Role Switching: Academic vs System Admin -->
                <div class="mb-4">
                    <label class="form-label text-xs fw-bold text-uppercase tracking-wider text-muted">Portal Domain</label>
                    <div class="segmented-control" role="group" aria-label="Domain Selection">
                        <input type="radio" class="btn-check" name="Role" id="roleAcademic" value="Academic" @(Model.Role == SIMS.Models.ViewModels.UserRoleType.Academic ? "checked" : "")>
                        <label class="btn flex-fill" for="roleAcademic">
                            <i class="bi bi-mortarboard me-1"></i> Academic (Student / Faculty)
                        </label>

                        <input type="radio" class="btn-check" name="Role" id="roleAdmin" value="SystemAdmin" @(Model.Role == SIMS.Models.ViewModels.UserRoleType.SystemAdmin ? "checked" : "")>
                        <label class="btn flex-fill" for="roleAdmin">
                            <i class="bi bi-shield-lock me-1"></i> System Admin
                        </label>
                    </div>
                </div>

                <!-- Username / Email Input -->
                <div class="mb-3">
                    <label asp-for="Username" class="form-label small fw-semibold text-secondary">Username or Institutional Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="Username" class="form-control form-control-modern border-start-0 ps-2" placeholder="e.g. student@university.edu or admin" required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <!-- Password Input -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0">Password</label>
                        <a href="#" class="small text-decoration-none text-primary fw-medium">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted ps-3">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control form-control-modern border-start-0 ps-2" placeholder="••••••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me -->
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                        <label class="form-check-label small text-secondary" for="rememberMe">
                            Stay logged in
                        </label>
                    </div>
                    <span class="badge bg-light text-muted border px-2 py-1 small">Secure Session</span>
                </div>

                <!-- Vibrant Login Button -->
                <button type="submit" class="btn btn-primary-gradient w-100 py-3 rounded-4 fw-bold fs-6 d-flex align-items-center justify-content-center gap-2">
                    <span>Sign In to SIMS</span>
                    <i class="bi bi-arrow-right"></i>
                </button>

                <!-- Student Registration Link -->
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account? 
                        <a asp-controller="Auth" asp-action="Register" class="text-primary fw-semibold text-decoration-none">
                            Register as Student <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .auth-hero-section {
        background: linear-gradient(145deg, #312e81 0%, #4338ca 45%, #6366f1 100%);
        min-height: 400px;
    }

    .hero-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.45;
        pointer-events: none;
    }

    .hero-orb-1 {
        width: 380px;
        height: 380px;
        background: #ec4899;
        top: -60px;
        left: -60px;
    }

    .hero-orb-2 {
        width: 320px;
        height: 320px;
        background: #06b6d4;
        bottom: -40px;
        right: -40px;
    }

    .illustration-card {
        max-width: 360px;
        transform: perspective(1000px) rotateX(4deg) rotateY(-6deg);
        background: rgba(255, 255, 255, 0.92) !important;
        border-radius: 20px;
    }

    .floating-badge {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 16px;
        z-index: 2;
        animation: floatAnimation 4s ease-in-out infinite alternate;
    }

    .badge-top-left {
        top: -15px;
        left: 20px;
    }

    .badge-bottom-right {
        bottom: -20px;
        right: 25px;
        animation-delay: 2s;
    }

    @@keyframes floatAnimation {
        0% { transform: translateY(0px); }
        100% { transform: translateY(-10px); }
    }
</style>
