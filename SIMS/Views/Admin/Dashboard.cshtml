@model SIMS.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Portal - System Management";
    ViewData["FluidLayout"] = true;
    ViewData["HideNav"] = true;
}

<div class="d-flex min-vh-100">
    <!-- Admin Sidebar -->
    <aside class="portal-sidebar d-none d-lg-flex flex-column p-3 position-sticky top-0" style="width: 280px; height: 100vh;">
        <div class="d-flex align-items-center gap-3 px-2 mb-4 pb-3 border-bottom">
            <div class="brand-icon" style="background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);">
                <i class="bi bi-shield-lock text-white fs-5"></i>
            </div>
            <div>
                <span class="fs-5 fw-bold gradient-text">SIMS</span>
                <span class="d-block small text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Admin Console</span>
            </div>
        </div>

        <nav class="nav flex-column gap-1 flex-grow-1">
            <a href="#" class="sidebar-nav-item active">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard Overview</span>
            </a>
            <a href="#studentRegistry" class="sidebar-nav-item">
                <i class="bi bi-people-fill"></i>
                <span>Student Management</span>
                <span class="badge rounded-pill bg-primary ms-auto">@Model.TotalStudents</span>
            </a>
            <a href="#" class="sidebar-nav-item">
                <i class="bi bi-person-workspace"></i>
                <span>Faculty & Instructors</span>
            </a>
            <a href="#" class="sidebar-nav-item">
                <i class="bi bi-book-half"></i>
                <span>Curriculum & Courses</span>
            </a>
            <a href="#auditLogsSection" class="sidebar-nav-item">
                <i class="bi bi-clock-history"></i>
                <span>Audit & Security Logs</span>
            </a>
            <div class="border-top my-3"></div>
            <a href="#" class="sidebar-nav-item text-muted">
                <i class="bi bi-sliders"></i>
                <span>System Parameters</span>
            </a>
        </nav>

        <div class="glass-card p-3 d-flex align-items-center gap-3 mt-auto">
            <div class="brand-icon rounded-circle" style="width: 42px; height: 42px; background: #ec4899;">
                <i class="bi bi-person-fill-lock text-white"></i>
            </div>
            <div class="overflow-hidden">
                <div class="fw-bold small text-truncate">@Model.AdminName</div>
                <div class="text-muted small" style="font-size: 0.75rem;">Root Administrator</div>
            </div>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-light ms-auto text-danger" title="Sign Out">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </aside>

    <!-- Admin Workspace Content Area -->
    <div class="flex-grow-1 d-flex flex-column bg-surface min-vh-100 overflow-hidden">
        <!-- Top Toolbar -->
        <header class="navbar glass-nav px-4 py-3 sticky-top border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold m-0 font-heading">System Administration & Registries</h5>
                <span class="small text-muted">SIMS Enterprise Core &bull; .NET 10.0 Architecture</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-arrow-repeat me-1"></i> Switch Role
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Index">Student View</a></li>
                        <li><a class="dropdown-item" asp-controller="Faculty" asp-action="Index">Faculty View</a></li>
                        <li><a class="dropdown-item active" asp-controller="Admin" asp-action="Index">Admin View</a></li>
                    </ul>
                </div>
                <button class="btn btn-primary-gradient btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                    <i class="bi bi-person-plus-fill me-1"></i> Add Student
                </button>
            </div>
        </header>

        <main class="p-3 p-lg-4 overflow-auto">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-4 d-flex align-items-center gap-2 p-3 mb-4 shadow-sm">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-4 d-flex align-items-center gap-2 p-3 mb-4 shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
            }

            <!-- 4 Statistic Cards Grid -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="glass-card p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Total Students</span>
                            <div class="stat-icon bg-primary-subtle text-primary">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                        </div>
                        <div class="display-6 fw-bold text-dark">@Model.TotalStudents</div>
                        <div class="small text-success mt-1">
                            <i class="bi bi-arrow-up-right me-1"></i> +8.2% from last term
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="glass-card p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Faculty Staff</span>
                            <div class="stat-icon bg-info-subtle text-info">
                                <i class="bi bi-person-video3"></i>
                            </div>
                        </div>
                        <div class="display-6 fw-bold text-dark">@Model.TotalFaculty</div>
                        <div class="small text-muted mt-1">Across 6 departments</div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="glass-card p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Active Courses</span>
                            <div class="stat-icon bg-warning-subtle text-warning">
                                <i class="bi bi-journal-code"></i>
                            </div>
                        </div>
                        <div class="display-6 fw-bold text-dark">@Model.ActiveCourses</div>
                        <div class="small text-success mt-1">100% syllabus scheduled</div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="glass-card p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Avg Institutional GPA</span>
                            <div class="stat-icon bg-success-subtle text-success">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                        </div>
                        <div class="display-6 fw-bold text-dark">@Model.AverageSystemGpa.ToString("0.00")</div>
                        <div class="small text-success mt-1">Benchmark: Standard 3.0+</div>
                    </div>
                </div>
            </div>

            <!-- Two-Column Main Area: Student Table & Audit Timeline -->
            <div class="row g-4" id="studentRegistry">
                <!-- Left 8 Columns: Student Management Data Table -->
                <div class="col-12 col-xl-8">
                    <div class="glass-card p-4">
                        <!-- Table Filters & Search Bar -->
                        <form method="get" asp-controller="Admin" asp-action="Dashboard" class="row g-3 align-items-center mb-4">
                            <div class="col-12 col-md-5">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3 text-muted">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" name="search" class="form-control form-control-modern border-start-0 rounded-end-pill" placeholder="Search by name, ID, email..." value="@Model.SearchQuery">
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <select name="program" class="form-select form-control-modern rounded-pill" onchange="this.form.submit()">
                                    <option value="All" selected="@(Model.SelectedProgramFilter == "All")">All Programs</option>
                                    <option value="Software Engineering" selected="@(Model.SelectedProgramFilter == "Software Engineering")">Software Eng.</option>
                                    <option value="Artificial Intelligence" selected="@(Model.SelectedProgramFilter == "Artificial Intelligence")">AI & Robotics</option>
                                    <option value="Cybersecurity" selected="@(Model.SelectedProgramFilter == "Cybersecurity")">Cybersecurity</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <select name="status" class="form-select form-control-modern rounded-pill" onchange="this.form.submit()">
                                    <option value="All" selected="@(Model.SelectedStatusFilter == "All")">All Status</option>
                                    <option value="Active" selected="@(Model.SelectedStatusFilter == "Active")">Active</option>
                                    <option value="Graduated" selected="@(Model.SelectedStatusFilter == "Graduated")">Graduated</option>
                                    <option value="Suspended" selected="@(Model.SelectedStatusFilter == "Suspended")">Suspended</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-2 d-flex justify-content-end">
                                <button type="submit" class="btn btn-outline-primary rounded-pill w-100">
                                    Filter
                                </button>
                            </div>
                        </form>

                        <!-- Student Records Table -->
                        <div class="table-responsive">
                            <table class="table table-modern align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Student ID & Name</th>
                                        <th>Program</th>
                                        <th>Enrollment</th>
                                        <th class="text-center">GPA</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Students.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                <i class="bi bi-search fs-2 d-block mb-2"></i>
                                                No student records found matching the query.
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var student in Model.Students)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="brand-icon rounded-circle" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                                        @student.FullName.Substring(0, 1)
                                                    </div>
                                                    <div>
                                                        <span class="fw-bold d-block text-dark">@student.FullName</span>
                                                        <span class="small text-muted">@student.StudentCode &bull; @student.Email</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border rounded-pill">@student.Program</span>
                                            </td>
                                            <td class="small text-muted">
                                                @student.EnrollmentDate.ToString("MMM yyyy")
                                            </td>
                                            <td class="text-center">
                                                <span class="fw-bold @(student.Gpa >= 3.5 ? "text-success" : student.Gpa >= 2.5 ? "text-primary" : "text-danger")">
                                                    @student.Gpa.ToString("0.00")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @(student.Status == "Active" ? "badge-soft-success" : student.Status == "Graduated" ? "badge-soft-primary" : "badge-soft-danger") rounded-pill px-3 py-1">
                                                    @student.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex gap-1 justify-content-end">
                                                    <button class="btn btn-sm btn-light rounded-circle" title="Edit Student Record" onclick="alert('Editing student @student.StudentCode')">
                                                        <i class="bi bi-pencil-fill text-muted"></i>
                                                    </button>
                                                    <form asp-controller="Admin" asp-action="DeleteStudent" method="post" onsubmit="return confirm('Archive record for @student.FullName?');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@student.Id" />
                                                        <button type="submit" class="btn btn-sm btn-light rounded-circle" title="Archive Student">
                                                            <i class="bi bi-trash-fill text-danger"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right 4 Columns: Read-Only Audit Log Timeline -->
                <div class="col-12 col-xl-4" id="auditLogsSection">
                    <div class="glass-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold font-heading m-0">System Audit Trail</h5>
                            <span class="badge bg-light text-muted border px-2 py-1 small">Read-Only</span>
                        </div>
                        <p class="small text-muted mb-4">Immutable log of security, grading, and administrative actions.</p>

                        <!-- Timeline Container -->
                        <div class="timeline-container position-relative">
                            @foreach (var log in Model.AuditLogs)
                            {
                                <div class="timeline-item d-flex gap-3 mb-4 position-relative">
                                    <div class="timeline-icon rounded-circle d-flex align-items-center justify-content-center @(log.Severity == "Warning" ? "bg-warning-subtle text-warning" : "bg-primary-subtle text-primary")" style="width: 36px; height: 36px; min-width: 36px; z-index: 2;">
                                        <i class="bi @(log.Severity == "Warning" ? "bi-shield-exclamation" : "bi-check2-circle")"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <span class="fw-bold small text-dark">@log.Action</span>
                                            <span class="text-muted" style="font-size: 0.7rem;">@log.TimeAgo</span>
                                        </div>
                                        <div class="small text-secondary mb-1">Target: <code>@log.TargetEntity</code></div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">By: @log.PerformedBy</span>
                                            <span class="badge @(log.Role == "Admin" ? "badge-soft-primary" : log.Role == "Faculty" ? "badge-soft-success" : "badge-soft-warning")" style="font-size: 0.65rem;">@log.Role</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Modal: Add Student -->
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon rounded-circle">
                        <i class="bi bi-person-plus-fill text-white"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold" id="addStudentModalLabel">Register New Student</h5>
                        <small class="text-muted">Creates student identity and matriculation records</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="CreateStudent" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Student Code / ID</label>
                            <input asp-for="NewStudent.StudentCode" class="form-control form-control-modern" placeholder="e.g. BH02888" required />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Degree Level</label>
                            <select asp-for="NewStudent.DegreeLevel" class="form-select form-control-modern">
                                <option value="Undergraduate">Undergraduate (B.Sc)</option>
                                <option value="Postgraduate">Postgraduate (M.Sc)</option>
                                <option value="Doctoral">Doctoral (Ph.D)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase">Full Legal Name</label>
                            <input asp-for="NewStudent.FullName" class="form-control form-control-modern" placeholder="e.g. Nguyen Van An" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase">Academic Program</label>
                            <select asp-for="NewStudent.Program" class="form-select form-control-modern">
                                <option value="Software Engineering">Software Engineering</option>
                                <option value="Artificial Intelligence">Artificial Intelligence & Robotics</option>
                                <option value="Cybersecurity">Cybersecurity & Networking</option>
                                <option value="Information Systems">Information Systems</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase">Institutional Email (Optional)</label>
                            <input asp-for="NewStudent.Email" type="email" class="form-control form-control-modern" placeholder="Leave blank to auto-generate" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top p-3 bg-light">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-gradient rounded-pill px-4 fw-bold">Register Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .timeline-container::before {
        content: '';
        position: absolute;
        top: 15px;
        bottom: 15px;
        left: 17px;
        width: 2px;
        background: var(--sims-border);
        z-index: 1;
    }
</style>

